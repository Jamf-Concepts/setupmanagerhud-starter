{
  "name": "setupmanagerhud",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "start": "node --experimental-strip-types src/server.ts",
    "deploy:cf": "wrangler d1 migrations apply DB --remote && wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "better-sqlite3": "^11.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "D1 database used to store Setup Manager webhook events."
      },
      "WEBHOOK_TOKEN": {
        "description": "Required shared secret for Setup Manager webhook POSTs. Generate with `openssl rand -hex 24`, save it securely, and configure the same value in Setup Manager. Do not leave blank."
      }
    }
  }
}
